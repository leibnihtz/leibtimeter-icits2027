type: dataset
title: "LeibtiMeter: supplementary technical documentation for ICITS 2027"
version: 1.0.0
date-released: 2026-11-18
license: CC-BY-4.0
authors:
  - family-names: Ayamamani-Choque
    given-names: Leibnihtz
